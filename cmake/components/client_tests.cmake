option(SWORDIGO_CLIENT_TESTS "Build focused ELF/JIT client tests without the editor suite" OFF)
if (SWORDIGO_CLIENT_TESTS)
    enable_testing()
    add_executable(client_preflight_test tests/client_preflight_test.cpp)
    target_include_directories(client_preflight_test PRIVATE ${SRC_DIR})
    set_target_properties(client_preflight_test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/${SWORDIGO_DIST_DIR}/tests")
    add_test(NAME client_preflight COMMAND client_preflight_test)
    add_executable(client_abi_test tests/client_abi_test.cpp)
    target_include_directories(client_abi_test PRIVATE ${SRC_DIR})
    set_target_properties(client_abi_test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/${SWORDIGO_DIST_DIR}/tests")
    add_test(NAME client_abi COMMAND client_abi_test)
    if (SWORDIGO_USE_DYNARMIC)
        add_executable(client_jit_test tests/client_jit_test.cpp)
        target_link_libraries(client_jit_test PRIVATE dynarmic)
        set_target_properties(client_jit_test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/${SWORDIGO_DIST_DIR}/tests")
        add_test(NAME client_jit COMMAND client_jit_test)
    endif()
    add_executable(client_io_test
        ${CMAKE_SOURCE_DIR}/tests/client_io_test.cpp
        ${SRC_DIR}/platform/io_thread.cpp
        ${SRC_DIR}/wincompat/pthread_mutex_shim.c)
    swordigo_target(client_io_test)
    target_link_libraries(client_io_test PRIVATE Threads::Threads)
    set_target_properties(client_io_test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/${SWORDIGO_DIST_DIR}/tests")
    add_test(NAME client_io COMMAND client_io_test)
    set_tests_properties(client_io PROPERTIES TIMEOUT 10)
    add_executable(client_program_state_test tests/client_program_state_test.cpp)
    target_include_directories(client_program_state_test PRIVATE ${SRC_DIR})
    set_target_properties(client_program_state_test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/${SWORDIGO_DIST_DIR}/tests")
    add_test(NAME client_program_state COMMAND client_program_state_test)
    add_executable(client_input_test tests/client_input_test.cpp ${SRC_DIR}/platform/input_config.cpp)
    swordigo_target(client_input_test)
    target_link_libraries(client_input_test PRIVATE SDL3::SDL3 OpenGL::GL)
    set_target_properties(client_input_test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/${SWORDIGO_DIST_DIR}/tests")
    add_test(NAME client_input COMMAND client_input_test)
endif()
